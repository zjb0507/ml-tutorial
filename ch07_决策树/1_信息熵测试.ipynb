   "cell_type": "code",
   "source": [
    "p=np.arange(0.01,1,0.01)\n",
    "H=-p*np.log(p)-(1-p)*np.log(1-p)     #信息熵，熵越大，随机变量各个结果的概率越平均，熵越小，某个结果的概率就越趋于1\n",
    "plt.plot(p,H)\n",
    "plt.show()"
   ],
